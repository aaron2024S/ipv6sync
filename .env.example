# ---- 华为路由器 IPv6 白名单同步 ----
# 复制成 .env 后按需修改；.env 里含密码，注意不要提交到公开仓库
#
# ⚠ 推荐做法：不用这个文件。compose 的 environment 里只设 ADMIN_USERNAME /
#   ADMIN_PASSWORD（控制台登录账号），其余设置（路由器地址与密码、NAS 的 MAC、
#   检测周期等）全部在网页控制台里填，存进 /data/settings.json，改完热生效。
#
# 本模板供进阶用法（Docker secret、批量部署、不想开控制台只想用环境变量）：
#   docker-compose 里写了 env_file: .env，容器启动时把下面这些变量塞进进程环境。
#   注意：网页设置（settings.json）的优先级**高于**这里的环境变量。
#   改完 .env 要 `docker compose up -d --force-recreate` 才会生效 —— 环境变量
#   只在容器创建时注入，restart 不会重新读。

# ============ 路由器 ============
# 路由器管理地址。NAS 在 192.168.3.0/24 网段里就保持默认；
# 换过 LAN 网段（比如 192.168.1.1）就改成实际的。
ROUTER_HOST=192.168.3.1
# 管理员用户名。华为家用路由固定是 admin，一般不用改。
ROUTER_USER=admin

# 管理员密码（本程序唯一需要的凭据）。三选一，按注释里的任一方式提供：
#   1) 直接写在这里（最简单；注意 .env 别被提交/同步出去）
ROUTER_PASSWORD=
#   2) 从文件读（Docker secret / 权限 600 的独立文件，比明文 .env 稳妥）
#      用了这个就把上面那行留空，并在 compose 里挂 secret，见 compose 里的注释
#ROUTER_PASSWORD_FILE=/run/secrets/router_password
#   3) 不提供密码，只复用已有会话：把有效的 session.json 放进 ./data/
#      （只在会话未过期时可用；它会过期，过期后仍要补密码）
#
# 记得：连续 3 次密码错会把 admin 账号锁掉。填之前先核对一遍。
ROUTER_TIMEOUT=10

# ============ 要维护的白名单条目 ============
# 条目名就是稳定主键：同名则原地更新，不会越加越多（白名单上限 32 条）
ENTRY_NAME=NAS
# 放通端口；留空或写 -1 表示该地址全部端口
# ⚠ 这里是 ENTRY_PORT，不是 PORT —— 别和下面的「控制台端口 PORT」混淆
ENTRY_PORT=-1
# 允许的来源，::/0 = 不限制
REMOTE_IP=::/0

# ============ 目标设备识别（可选） ============
# 取址只有一条路：读**本机网卡**的全局 IPv6（所以必须以 host 网络部署）。
# 本机网卡上所有可用的全局地址都会各写一条白名单：NAS、NAS@2、NAS@3…
# （多端口时再拼端口，如 NAS@2-5005）。
#
# TARGET_MAC 可以不填；填了就核对一下 —— 若这个 MAC 不在本机网卡上，
# 状态页会给出提醒（不会中断运行）。想要更精确也可以填。
# 不知道本机 MAC？先跑一次：
#   docker compose run --rm ipv6sync --list-hosts
TARGET_MAC=

# ============ 行为 ============
# 轮询间隔（秒）
POLL_INTERVAL=60
# IPv6 防火墙总开关若为关，白名单不会生效；设 true 则本程序自动打开它
ENSURE_FIREWALL_ON=false
# 写完回读核对（建议开）
VERIFY_AFTER_WRITE=true
# 只打印不写路由器
DRY_RUN=false
# 跑一轮就退出（配合 NAS 的计划任务用）
ONCE=false

# 密码错误后的退避（秒）。设备连续 3 次密码错就锁账号，别调太小
LOGIN_BACKOFF_BASE=300
LOGIN_BACKOFF_MAX=21600
# 网络类错误的重试间隔（秒）
NET_RETRY_DELAY=15

# ============ 通知（可选；也可只在网页控制台「通知设置」里配） ============
# 防火墙白名单每次被本程序修改后（写条目/删条目/自动开总开关），推送一条变更消息
# 三个渠道互相独立，启用几个就同时推几个
# 三渠道共用的消息标题（测试通知会自动加「（测试）」后缀）
#NOTIFY_TITLE=IPv6 白名单已更新
#NOTIFY_NTFY_ENABLED=false
# ntfy 服务器地址，建议带上主题（如 https://ntfy.sh/mytopic；不写默认发到 ipv6sync）
#NOTIFY_NTFY_URL=
#NOTIFY_NTFY_TOKEN=
#NOTIFY_NTFY_TOKEN_FILE=/run/secrets/ntfy_token
#NOTIFY_GOTIFY_ENABLED=false
# gotify 服务器地址，只填到根路径
#NOTIFY_GOTIFY_URL=
#NOTIFY_GOTIFY_TOKEN=
#NOTIFY_GOTIFY_TOKEN_FILE=/run/secrets/gotify_token
#NOTIFY_WECOM_ENABLED=false
# 企业微信群机器人 ID：webhook 里 key= 后面那段；粘贴整个 webhook 地址也行
#NOTIFY_WECOM_ID=

# ============ 浏览器控制台（可选） ============
# 填了 ADMIN_PASSWORD 才会启动；不填就不开这个端口（安全默认）。
# 推荐直接写在 compose 的 environment 里：
#   environment:
#     - ADMIN_USERNAME=admin
#     - ADMIN_PASSWORD=你的口令
# 打开 http://<本机IP>:6600/ ，用这对账号登录，可以看状态、改上面的所有设置、
# 读路由器白名单与设备列表 —— 改完即生效，不用重建容器。
#
# ⚠ 这是局域网内的管理后台：不要映射到公网，别用弱口令。
#    它能改路由器密码，等于路由器管理权的一部分。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 改从文件读控制台密码（Docker secret 场景）
#ADMIN_PASSWORD_FILE=/run/secrets/web_password
# 控制台端口（0 = 关闭控制台）与监听地址；compose 里直接 - PORT=xxxx 也行
PORT=6600
WEB_HOST=0.0.0.0
# 登录有效期（秒），默认 12 小时
WEB_SESSION_TTL=43200

# 网页里改的设置存在这里；优先级高于环境变量（网页设置 > .env > 默认值）
SETTINGS_FILE=/data/settings.json

# 累计写入次数落盘在哪。留空 = 跟随 SETTINGS_FILE 同目录的 state.json。
# 它在挂载卷里，所以容器重建 / NAS 重启后「累计写入」不会归零 ——
# 网页上就靠这个判断程序到底同步过没有。
# STATE_FILE=/data/state.json

# ============ 观测 ============
HEALTH_PORT=8099
LOG_LEVEL=INFO
# 输出 JSON 日志（便于 NAS 上的日志采集）
LOG_JSON=false

# 会话缓存路径（容器内，挂到卷上；只存 Cookie 与 CSRF 令牌，不含密码）
SESSION_FILE=/data/session.json

# 时区
TZ=Asia/Shanghai
