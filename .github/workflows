# ============================================================================
# 复制这个文件的全部内容 → 粘到你的仓库的
#     .github/workflows/docker-build-push.yml
# 然后只需要改 4 个地方（下面标了「改这里」）。
#
# 前置条件：
#   1. 仓库里要有 Dockerfile（没有就先自己写一个）
#   2. 仓库 Settings → Secrets and variables → Actions → Secrets 分页，
#      建 DOCKERHUB_USERNAME（必须全小写）和 DOCKERHUB_TOKEN 两个 secret
# ============================================================================
name: docker-build-push

# ── 改这里 ①  触发方式 ──────────────────────────────────────────────────────
# 手动点按钮触发（默认，最可控）
on:
  workflow_dispatch:
    inputs:
      tag:
        description: '镜像标签（默认 latest）'
        required: false
        default: 'latest'
        type: string

  # 想让「改了代码就自动构建」，就把下面两行前面的 # 去掉，
  # 并把分支名换成你这个仓库的默认分支（main 或 master）
  # push:
  #   branches: [main]

  # 想「只有打 git tag 才构建」，用这段替换上面两行：
  # push:
  #   tags: ['v*']

env:
  IMAGE_NAME: ipv6sync   # ── 改这里 ②  镜像名，只能小写 ──

jobs:
  docker:
    runs-on: ubuntu-latest
    env:
      DOCKERHUB_USER: ${{ secrets.DOCKERHUB_USERNAME }}
    steps:
      - name: 拉取代码
        uses: actions/checkout@v6

      # 只要 linux/amd64 的话，把下面这 2 行删掉（能快不少）
      - name: 准备 QEMU（构建 arm64 用）
        uses: docker/setup-qemu-action@v4

      - name: 准备 Buildx
        uses: docker/setup-buildx-action@v4

      - name: 登录 Docker Hub
        uses: docker/login-action@v4
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      - name: 构建并推送
        id: build
        uses: docker/build-push-action@v7
        with:
          context: .                          # ── 改这里 ③  Dockerfile 在子目录时改路径
          file: ./Dockerfile                  #             例：./apps/web + ./apps/web/Dockerfile
          platforms: linux/amd64,linux/arm64  # ── 改这里 ④  只要 x86 就写 linux/amd64
          push: true
          tags: ${{ env.DOCKERHUB_USER }}/${{ env.IMAGE_NAME }}:${{ inputs.tag || 'latest' }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

      # 把结果写进运行摘要，方便你直接看到镜像名和 digest（可以整段删掉）
      - name: 结果汇总
        run: |
          echo "### 镜像已推送" >> "$GITHUB_STEP_SUMMARY"
          echo "" >> "$GITHUB_STEP_SUMMARY"
          echo "- 名称：\`$DOCKERHUB_USER/$IMAGE_NAME:${{ inputs.tag || 'latest' }}\`" >> "$GITHUB_STEP_SUMMARY"
          echo "- 摘要：\`${{ steps.build.outputs.digest }}\`" >> "$GITHUB_STEP_SUMMARY"
          echo "- 拉取：\`docker pull $DOCKERHUB_USER/$IMAGE_NAME:${{ inputs.tag || 'latest' }}\`" >> "$GITHUB_STEP_SUMMARY"
